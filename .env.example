# Copier ce fichier en .env et adapter les valeurs. Ne jamais versionner .env.
# ENV=dev autorise le secret par défaut ; toute autre valeur l'interdit.
ENV=dev
# Secret de signature des JWT : 32 caractères au moins hors développement.
# PowerShell : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=a-remplacer-par-un-secret-aleatoire
DATABASE_URL=sqlite:///./stochastiq.db
# Origine du front (CORS) ; sert aussi à construire les liens d'invitation.
CORS_ORIGIN=http://localhost:5173
# Dossier du modèle de prédiction (entraîné au premier démarrage du conteneur s'il est absent).
# Sous Docker, docker-compose.yml impose /data/models.
MODELS_DIR=./models
